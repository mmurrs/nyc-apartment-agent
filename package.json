{
  "name": "nyc-apartment-agent",
  "version": "0.1.0",
  "description": "Natural-language NYC apartment search for agents and personal workflows. Aggregates StreetEasy, The Listings Project, Craigslist, and Facebook Marketplace; paid per request via x402/MPP; deployed verifiably on EigenCompute.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env server.js",
    "test": "node --test tests/smoke.mjs tests/query.test.mjs tests/parsers.test.mjs",
    "init": "./scripts/init.sh",
    "deploy": "./scripts/deploy.sh"
  },
  "dependencies": {
    "@layr-labs/ai-gateway-provider": "^1.0.1",
    "@x402/evm": "^2.17.0",
    "@x402/fetch": "^2.17.0",
    "ai": "^6.0.0",
    "dual402": "^0.1.0",
    "express": "^5.0.0"
  },
  "overrides": {
    "mppx": "0.6.14"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmurrs/nyc-apartment-agent.git"
  }
}
