{
  "name": "dual402-starter",
  "version": "0.1.0",
  "description": "Starter template for paid APIs on EigenCompute. Accept both x402 (Base mainnet USDC) and MPP (Tempo USDC) on every route out of the box.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env server.js",
    "test": "node --test tests/smoke.mjs",
    "init": "./scripts/init.sh",
    "deploy": "./scripts/deploy.sh"
  },
  "dependencies": {
    "dual402": "^0.1.0",
    "express": "^5.0.0"
  },
  "overrides": {
    "mppx": "0.6.14"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmurrs/dual402-starter.git"
  }
}
