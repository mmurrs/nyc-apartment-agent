# ─── Service identity ─────────────────────────────────────────────────
SERVICE_NAME=my-paid-api
SERVICE_VERSION=0.1.0

# ─── Shared recipient (convenience) ───────────────────────────────────
# Used as the default for BOTH MPP_RECIPIENT and X402_PAYEE_ADDRESS.
# Generate a dedicated merchant wallet — do NOT reuse your AgentCash
# or personal wallet, or CDP will reject self-transfers.
#   cast wallet new
RECIPIENT_WALLET=

# ─── MPP (Tempo USDC) ─────────────────────────────────────────────────
# HMAC key used by mppx to sign/verify challenges. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MPP_SECRET_KEY=

# Tempo USDC token contract address
#   Mainnet (chain 4217):  0x20C000000000000000000000b9537d11c60E8b50
#   Testnet (chain 42431): 0x20c0000000000000000000000000000000000000
USDC_TEMPO=0x20C000000000000000000000b9537d11c60E8b50

# Optional — overrides RECIPIENT_WALLET for MPP only
MPP_RECIPIENT=

# Optional — hostname to advertise in MPP WWW-Authenticate challenges.
# Set to your public domain (e.g. my-api.dev) when behind a proxy.
MPP_REALM=

# Set to "true" to use Tempo testnet instead of mainnet.
MPP_TESTNET=false

# ─── x402 (Base USDC) ─────────────────────────────────────────────────
# Optional — overrides RECIPIENT_WALLET for x402 only
X402_PAYEE_ADDRESS=

# CAIP-2 chain ID:
#   eip155:8453    Base mainnet (default — production)
#   eip155:84532   Base Sepolia (testing)
X402_NETWORK=eip155:8453

# Facilitator /verify + /settle endpoint:
#   Mainnet:  https://api.cdp.coinbase.com/platform/v2/x402  (requires CDP keys)
#   Testnet:  https://x402.org/facilitator                    (no auth)
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# CDP API credentials. REQUIRED when using the CDP hosted facilitator.
#   1. Create an API key at https://portal.cdp.coinbase.com/
#   2. Ed25519 preferred; EC (ES256) also works.
#   3. ID is a UUID (or organizations/.../apiKeys/... path).
#   4. SECRET is base64 Ed25519 (one line) or PEM (use \n for newlines).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ─── Public URL ───────────────────────────────────────────────────────
# Set when behind a proxy/CDN so clients see your public hostname
# in x402 challenges and /.well-known/x402 discovery.
BASE_URL=

# ─── Outbound payer (this service BUYS its inputs) ────────────────────
# Dedicated wallet that pays stableenrich (Firecrawl for StreetEasy) and
# stablesocial (FB Marketplace) per search. NOT the merchant wallet.
# Without it, paid sources are skipped; free sources still work.
#   cast wallet new
PAYER_PRIVATE_KEY=

# ─── LLM via EigenCloud AI Gateway (optional but recommended) ─────────
# On sepolia/mainnet-alpha MUST be the prod gateway; the package default
# (ai-gateway-dev) 401s against prod KMS JWTs.
EIGEN_GATEWAY_URL=https://ai-gateway.eigencloud.xyz
# Inside EigenCompute, KMS_SERVER_URL/KMS_PUBLIC_KEY are auto-injected and
# auth happens via attestation. For LOCAL dev only, paste a static JWT:
KMS_AUTH_JWT=
# Model for constraint refinement + fit notes.
MODEL=anthropic/claude-haiku-4-5

# Optional upstream base URL overrides
STABLEENRICH_URL=https://stableenrich.dev
STABLESOCIAL_URL=https://stablesocial.dev

PORT=8080
